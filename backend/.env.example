# ─── Banco de Dados ───────────────────────────────────────────────────────────
# PostgreSQL (recomendado para produção)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/agendepro?schema=public"

# SQLite (opcional para desenvolvimento local)
# DATABASE_URL="file:./dev.db"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=seu-segredo-super-secreto-mude-em-producao
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Múltiplas origens separadas por vírgula
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Upload de Arquivos ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ─── Segurança ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
