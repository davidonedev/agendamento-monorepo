# ─── Banco de Dados (banco separado do backend Node — agendepro_java) ─────────
DB_URL=jdbc:postgresql://localhost:5432/agendepro_java
DB_USERNAME=postgres
DB_PASSWORD=root

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3333

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=seu-segredo-super-secreto-mude-em-producao
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Upload de Arquivos ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ─── Segurança ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ─── E-mail (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgendePro <noreply@agendepro.com>

# URL pública do frontend (usada nos links de e-mail/WhatsApp)
APP_URL=http://localhost:5173

# ─── Seed de dados de demonstração ─────────────────────────────────────────────
# true = popula o banco com tenants/profissionais/serviços de exemplo ao subir
SEED_ENABLED=true
